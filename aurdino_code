#include <Servo.h>

Servo servos[5];

String data = "";
int angles[5];

void setup() {
  Serial.begin(9600);

  // attach 5 servos to pins 3,5,6,9,10 (change if needed)
  servos[0].attach(3);
  servos[1].attach(5);
  servos[2].attach(6);
  servos[3].attach(9);
  servos[4].attach(10);
}

void loop() {
  while (Serial.available()) {
    char c = Serial.read();

    if (c == '\n') {
      
      // parse 5 integers from string
      int idx = 0;
      char *token;

      char buf[data.length() + 1];
      data.toCharArray(buf, sizeof(buf));

      token = strtok(buf, " ");

      while (token != NULL && idx < 5) {
        angles[idx] = constrain(atoi(token), 0, 180);
        token = strtok(NULL, " ");
        idx++;
      }

      // move servos
      for (int i = 0; i < 5; i++) {
        servos[i].write(angles[i]);
      }

      data = "";
    }
    else {
      data += c;
    }
  }
}
